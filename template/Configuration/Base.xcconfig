#include "Version.xcconfig"

// Single source of truth for the minimum OS across every product target.
// `make check` fails if this lands in project.pbxproj instead: a target-level
// IPHONEOS_DEPLOYMENT_TARGET silently shadows this file, and the first sign of
// it is a user on the old OS whose app will not open.
//
// Whatever number is here is a promise. Keep `scripts/audit-ios-floor.sh` in
// the release gate so the build cannot quietly break it — the SDK raises the
// floor without asking (see SKILL.md, "The deployment floor is not what you
// set — it is what the linker believes").
IPHONEOS_DEPLOYMENT_TARGET = 15.0
MACOSX_DEPLOYMENT_TARGET = 13.0

// The asset catalogue's icon set, named here rather than in the pbxproj.
// Without it the catalogue still compiles and the app still builds — it just
// ships with no icon key in its Info.plist, which is the kind of silent loss a
// packaging verifier has to fail on.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// `#file` in Swift 5 mode is the absolute path of the source, so every
// `fatalError` and `precondition` would otherwise ship the build machine's
// home directory; SE-0274 makes it `Module/File.swift` instead. The prefix
// maps cover debug info and C's `__FILE__`. The packager greps every binary
// for the repository root and fails on a path that slipped through anyway —
// a dependency spelling `#file` in a default argument leaks the caller's.
SWIFT_UPCOMING_FEATURE_CONCISE_MAGIC_FILE = YES
OTHER_SWIFT_FLAGS = $(inherited) -file-prefix-map $(SRCROOT)=. -file-prefix-map $(OBJROOT)/../..=DerivedData
OTHER_CFLAGS = $(inherited) -ffile-prefix-map=$(SRCROOT)=. -ffile-prefix-map=$(OBJROOT)/../..=DerivedData

// C module maps that Swift needs on the include path — the XPC constant shim
// among them. A directory named here is not a compile-sources group; it is a
// header the importer finds.
SWIFT_INCLUDE_PATHS = $(inherited) $(SRCROOT)/Shared/XPCShim

// Shared documents exported by the app and its extensions. Both packaging
// wrappers require the same group on the app and on every embedded extension.
// Override in the git-ignored Developer*.xcconfig when provisioning another.
APP_GROUP_IDENTIFIER = group.@BUNDLE_ID@
