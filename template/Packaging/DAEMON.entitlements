<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	The daemon's entitlements. Keep this list at exactly what the daemon needs
	to do its job as root, and re-read it out of the *signed* binary in
	verify-deb.sh: a lost entitlement does not break the build, it makes the
	daemon refuse the app at runtime, which looks like a bug anywhere but where
	it is.

	`platform-application` is what lets an ad-hoc signed binary run as a
	platform binary at all. The two storage entitlements are what let it reach
	app bundles and data containers; drop either one if the daemon has no
	business there.
-->
<plist version="1.0">
<dict>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>platform-application</key>
	<true/>
</dict>
</plist>
