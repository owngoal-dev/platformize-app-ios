<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Helper-per-job only. Delete this file when the daemon has no helper.

	The helper is the process that does the job (install, unpack, register).
	It needs the daemon's platform / no-sandbox / AppBundles / AppDataContainers
	set, plus whatever the job itself touches. The daemon gets none of the
	job-specific keys: LaunchServices, FrontBoard, data vaults.

	`com.apple.private.security.storage.<Class>` is a kernel data-vault. A
	package that places a file under `/var/mobile/Library/Preferences`,
	Keychains, Photos, … fails with EPERM without the class, root included.
	A class the running OS does not know is ignored.

	`container-required = false` is not the same as omitting the key. Sign the
	helper with ldid and re-read the entitlements out of the signed binary.
-->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
</dict>
</plist>
